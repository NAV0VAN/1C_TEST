// Примеры для ручной проверки правила S→B и дублей в консоли/отладке.

Процедура ПроверитьПримерыПреобразования() Экспорт
	
	Баночный = "A#N#N#1#S#A#EC-B26B-3,75#20260305MO000000#20260305#N0000000";
	Ожидаемый = "A#N#N#1#B#A#EC-B26B-3,75#20260305MO000000#20260305#N0000000";
	
	Обработка = ВнешниеОбработки.Создать("СозданиеКоробочныхШтрихкодовНоменклатуры");
	// Либо: Обработка = ВнешниеОбработки.Создать(ПутьКФайлуEpf);
	
	Результат = Обработка.ПолучитьКоробочныйШтрихкод(Баночный);
	Если Результат <> Ожидаемый Тогда
		ВызватьИсключение "Ошибка преобразования S→B";
	КонецЕсли;
	
	Если Не Обработка.ЭтоБаночныйШтрихкод(Баночный) Тогда
		ВызватьИсключение "Баночный ШК не распознан";
	КонецЕсли;
	
	Если Не Обработка.ЭтоКоробочныйШтрихкод(Ожидаемый) Тогда
		ВызватьИсключение "Коробочный ШК не распознан";
	КонецЕсли;
	
	// Дубль: после первого СоздатьКоробочныеШтрихкоды повторный вызов
	// должен увеличить ПропущеноДубли, а не Создано.
	
КонецПроцедуры
