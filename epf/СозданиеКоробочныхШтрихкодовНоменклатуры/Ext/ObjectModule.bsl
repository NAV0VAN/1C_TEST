#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает таблицу для предварительного просмотра: баночные ШК и предлагаемые коробочные.
//
// Параметры:
//  ТолькоОтсутствующие - Булево - если Истина, в результат попадут только строки,
//                                 у которых коробочный ШК ещё не записан в регистр.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки:
//   * БаночныйШтрихкод, КоробочныйШтрихкод, Номенклатура, Характеристика, Партия,
//     ЕдиницаИзмерения, Статус, Комментарий, Выбран
//
Функция ПолучитьТаблицуКСозданию(ТолькоОтсутствующие = Истина) Экспорт
	
	ТаблицаРезультат = НоваяТаблицаКСозданию();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод,
	|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
	|	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика,
	|	ШтрихкодыНоменклатуры.Партия КАК Партия,
	|	ШтрихкодыНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|ГДЕ
	|	ШтрихкодыНоменклатуры.Штрихкод ПОДОБНО ""%#S#%""";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		КоробочныйШтрихкод = ПолучитьКоробочныйШтрихкод(Выборка.Штрихкод);
		Если Не ЗначениеЗаполнено(КоробочныйШтрихкод) Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеДубля = НайтиДубльШтрихкода(КоробочныйШтрихкод);
		
		НоваяСтрока = ТаблицаРезультат.Добавить();
		НоваяСтрока.БаночныйШтрихкод   = Выборка.Штрихкод;
		НоваяСтрока.КоробочныйШтрихкод = КоробочныйШтрихкод;
		НоваяСтрока.Номенклатура       = Выборка.Номенклатура;
		НоваяСтрока.Характеристика     = Выборка.Характеристика;
		НоваяСтрока.Партия             = Выборка.Партия;
		НоваяСтрока.ЕдиницаИзмерения   = Выборка.ЕдиницаИзмерения;
		
		ЗаполнитьСтатусПоДублям(НоваяСтрока, ДанныеДубля);
		
		Если ТолькоОтсутствующие И НоваяСтрока.Статус <> "КСозданию" Тогда
			ТаблицаРезультат.Удалить(НоваяСтрока);
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока.Выбран = (НоваяСтрока.Статус = "КСозданию");
		
	КонецЦикла;
	
	ПроверитьДублиВнутриВыборки(ТаблицаРезультат);
	
	Возврат ТаблицаРезультат;
	
КонецФункции

// Создаёт записи коробочных ШК в РС.ШтрихкодыНоменклатуры по отмеченным строкам.
// Перед записью повторно проверяет дубли в регистре и внутри пакета.
//
// Параметры:
//  ТаблицаКСозданию - ТаблицаЗначений - результат ПолучитьТаблицуКСозданию / данные формы.
//
// Возвращаемое значение:
//  Структура:
//   * Создано, ПропущеноДубли, Ошибок, Сообщения (Массив из Строка)
//
Функция СоздатьКоробочныеШтрихкоды(ТаблицаКСозданию) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Создано", 0);
	Результат.Вставить("ПропущеноДубли", 0);
	Результат.Вставить("Ошибок", 0);
	Результат.Вставить("Сообщения", Новый Массив);
	
	Если ТаблицаКСозданию = Неопределено Или ТаблицаКСозданию.Количество() = 0 Тогда
		Результат.Сообщения.Добавить("Нет строк для создания коробочных штрихкодов.");
		Возврат Результат;
	КонецЕсли;
	
	// Защита от дублей внутри одного запуска: один и тот же коробочный ШК из разных баночных.
	ОбработанныеКоробочные = Новый Соответствие;
	
	Для Каждого СтрокаТаблицы Из ТаблицаКСозданию Цикл
		
		Если Не СтрокаТаблицы.Выбран Тогда
			Продолжить;
		КонецЕсли;
		
		КоробочныйШтрихкод = СокрЛП(СтрокаТаблицы.КоробочныйШтрихкод);
		Если Не ЗначениеЗаполнено(КоробочныйШтрихкод) Тогда
			Результат.Ошибок = Результат.Ошибок + 1;
			Результат.Сообщения.Добавить(
				СтрШаблон("Пустой коробочный ШК для баночного: %1", СтрокаТаблицы.БаночныйШтрихкод));
			Продолжить;
		КонецЕсли;
		
		Если Не ЭтоБаночныйШтрихкод(СтрокаТаблицы.БаночныйШтрихкод) Тогда
			Результат.Ошибок = Результат.Ошибок + 1;
			Результат.Сообщения.Добавить(
				СтрШаблон("Исходный ШК не является баночным (ожидается сегмент S): %1",
					СтрокаТаблицы.БаночныйШтрихкод));
			Продолжить;
		КонецЕсли;
		
		ОжидаемыйКоробочный = ПолучитьКоробочныйШтрихкод(СтрокаТаблицы.БаночныйШтрихкод);
		Если КоробочныйШтрихкод <> ОжидаемыйКоробочный Тогда
			Результат.Ошибок = Результат.Ошибок + 1;
			Результат.Сообщения.Добавить(
				СтрШаблон("Коробочный ШК не соответствует правилу S→B. Баночный: %1, ожидалось: %2, указано: %3",
					СтрокаТаблицы.БаночныйШтрихкод, ОжидаемыйКоробочный, КоробочныйШтрихкод));
			Продолжить;
		КонецЕсли;
		
		// Дубль внутри пакета создания.
		Если ОбработанныеКоробочные.Получить(КоробочныйШтрихкод) <> Неопределено Тогда
			Результат.ПропущеноДубли = Результат.ПропущеноДубли + 1;
			Результат.Сообщения.Добавить(
				СтрШаблон("Пропуск: коробочный ШК уже обрабатывается в этом запуске (дубль в пакете): %1",
					КоробочныйШтрихкод));
			Продолжить;
		КонецЕсли;
		
		// Дубль в регистре сведений.
		ДанныеДубля = НайтиДубльШтрихкода(КоробочныйШтрихкод);
		Если ДанныеДубля.Найден Тогда
			
			Результат.ПропущеноДубли = Результат.ПропущеноДубли + 1;
			
			Если ДанныеДубля.Номенклатура = СтрокаТаблицы.Номенклатура
				И ДанныеДубля.Характеристика = СтрокаТаблицы.Характеристика
				И ДанныеДубля.Партия = СтрокаТаблицы.Партия
				И ДанныеДубля.ЕдиницаИзмерения = СтрокаТаблицы.ЕдиницаИзмерения Тогда
				
				Результат.Сообщения.Добавить(
					СтрШаблон("Пропуск: коробочный ШК уже существует для той же номенклатуры: %1",
						КоробочныйШтрихкод));
			Иначе
				Результат.Сообщения.Добавить(
					СтрШаблон(
						"Пропуск (конфликт дубля): ШК %1 уже привязан к другой позиции (Номенклатура=%2, Характеристика=%3, Партия=%4, ЕИ=%5)",
						КоробочныйШтрихкод,
						ДанныеДубля.Номенклатура,
						ДанныеДубля.Характеристика,
						ДанныеДубля.Партия,
						ДанныеДубля.ЕдиницаИзмерения));
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
		Попытка
			
			МенеджерЗаписи = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Штрихкод         = КоробочныйШтрихкод;
			МенеджерЗаписи.Номенклатура     = СтрокаТаблицы.Номенклатура;
			МенеджерЗаписи.Характеристика   = СтрокаТаблицы.Характеристика;
			МенеджерЗаписи.Партия           = СтрокаТаблицы.Партия;
			МенеджерЗаписи.ЕдиницаИзмерения = СтрокаТаблицы.ЕдиницаИзмерения;
			МенеджерЗаписи.Записать();
			
			ОбработанныеКоробочные.Вставить(КоробочныйШтрихкод, Истина);
			Результат.Создано = Результат.Создано + 1;
			
		Исключение
			
			Результат.Ошибок = Результат.Ошибок + 1;
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			
			// Повторная проверка: конкурентная запись могла создать дубль между проверкой и записью.
			ДанныеДубляПослеОшибки = НайтиДубльШтрихкода(КоробочныйШтрихкод);
			Если ДанныеДубляПослеОшибки.Найден Тогда
				Результат.ПропущеноДубли = Результат.ПропущеноДубли + 1;
				Результат.Ошибок = Результат.Ошибок - 1;
				Результат.Сообщения.Добавить(
					СтрШаблон("Пропуск: при записи обнаружен дубль ШК %1 (%2)",
						КоробочныйШтрихкод, ТекстОшибки));
			Иначе
				Результат.Сообщения.Добавить(
					СтрШаблон("Ошибка записи ШК %1: %2", КоробочныйШтрихкод, ТекстОшибки));
			КонецЕсли;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Результат.Сообщения.Добавить(
		СтрШаблон("Итого: создано %1, пропущено из‑за дублей %2, ошибок %3.",
			Результат.Создано, Результат.ПропущеноДубли, Результат.Ошибок));
	
	Возврат Результат;
	
КонецФункции

// Преобразует баночный ШК в коробочный по правилу: сегмент упаковки S → B.
// Пример:
//  A#N#N#1#S#A#EC-B26B-3,75#... → A#N#N#1#B#A#EC-B26B-3,75#...
//
Функция ПолучитьКоробочныйШтрихкод(БаночныйШтрихкод) Экспорт
	
	Если Не ЗначениеЗаполнено(БаночныйШтрихкод) Тогда
		Возврат "";
	КонецЕсли;
	
	// Третий параметр Истина — сохраняем позиции сегментов (в т.ч. пустые).
	Части = СтрРазделить(СокрЛП(БаночныйШтрихкод), "#", Истина);
	Если Части.Количество() < 5 Тогда
		Возврат "";
	КонецЕсли;
	
	Если ВРег(СокрЛП(Части[4])) <> "S" Тогда
		Возврат "";
	КонецЕсли;
	
	Части[4] = "B";
	Возврат СтрСоединить(Части, "#");
	
КонецФункции

Функция ЭтоБаночныйШтрихкод(Штрихкод) Экспорт
	
	Если Не ЗначениеЗаполнено(Штрихкод) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Части = СтрРазделить(СокрЛП(Штрихкод), "#", Истина);
	Если Части.Количество() < 5 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ВРег(СокрЛП(Части[4])) = "S";
	
КонецФункции

Функция ЭтоКоробочныйШтрихкод(Штрихкод) Экспорт
	
	Если Не ЗначениеЗаполнено(Штрихкод) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Части = СтрРазделить(СокрЛП(Штрихкод), "#", Истина);
	Если Части.Количество() < 5 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ВРег(СокрЛП(Части[4])) = "B";
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяТаблицаКСозданию()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Выбран",              Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("БаночныйШтрихкод",    Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));
	Таблица.Колонки.Добавить("КоробочныйШтрихкод",  Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));
	Таблица.Колонки.Добавить("Номенклатура");
	Таблица.Колонки.Добавить("Характеристика");
	Таблица.Колонки.Добавить("Партия");
	Таблица.Колонки.Добавить("ЕдиницаИзмерения");
	Таблица.Колонки.Добавить("Статус",              Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Комментарий",         Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)));
	
	Возврат Таблица;
	
КонецФункции

// Ищет существующую запись с тем же значением Штрихкод в регистре.
//
Функция НайтиДубльШтрихкода(Штрихкод)
	
	Результат = Новый Структура;
	Результат.Вставить("Найден", Ложь);
	Результат.Вставить("Номенклатура");
	Результат.Вставить("Характеристика");
	Результат.Вставить("Партия");
	Результат.Вставить("ЕдиницаИзмерения");
	
	Если Не ЗначениеЗаполнено(Штрихкод) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод,
	|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
	|	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика,
	|	ШтрихкодыНоменклатуры.Партия КАК Партия,
	|	ШтрихкодыНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|ГДЕ
	|	ШтрихкодыНоменклатуры.Штрихкод = &Штрихкод";
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Найден           = Истина;
		Результат.Номенклатура     = Выборка.Номенклатура;
		Результат.Характеристика   = Выборка.Характеристика;
		Результат.Партия           = Выборка.Партия;
		Результат.ЕдиницаИзмерения = Выборка.ЕдиницаИзмерения;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьСтатусПоДублям(СтрокаТаблицы, ДанныеДубля)
	
	Если Не ДанныеДубля.Найден Тогда
		СтрокаТаблицы.Статус = "КСозданию";
		СтрокаТаблицы.Комментарий = "Коробочный ШК отсутствует — можно создать";
		Возврат;
	КонецЕсли;
	
	Если ДанныеДубля.Номенклатура = СтрокаТаблицы.Номенклатура
		И ДанныеДубля.Характеристика = СтрокаТаблицы.Характеристика
		И ДанныеДубля.Партия = СтрокаТаблицы.Партия
		И ДанныеДубля.ЕдиницаИзмерения = СтрокаТаблицы.ЕдиницаИзмерения Тогда
		
		СтрокаТаблицы.Статус = "УжеЕсть";
		СтрокаТаблицы.Комментарий = "Коробочный ШК уже есть для этой же позиции (дубль)";
	Иначе
		СтрокаТаблицы.Статус = "КонфликтДубля";
		СтрокаТаблицы.Комментарий = СтрШаблон(
			"ШК уже занят другой позицией: %1 / %2 / %3 / %4",
			ДанныеДубля.Номенклатура,
			ДанныеДубля.Характеристика,
			ДанныеДубля.Партия,
			ДанныеДубля.ЕдиницаИзмерения);
	КонецЕсли;
	
КонецПроцедуры

// Помечает строки, у которых один и тот же коробочный ШК получается из разных баночных.
//
Процедура ПроверитьДублиВнутриВыборки(ТаблицаРезультат)
	
	Счетчики = Новый Соответствие;
	
	Для Каждого СтрокаТаблицы Из ТаблицаРезультат Цикл
		Ключ = СтрокаТаблицы.КоробочныйШтрихкод;
		Если Не ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Текущее = Счетчики.Получить(Ключ);
		Счетчики.Вставить(Ключ, ?(Текущее = Неопределено, 1, Текущее + 1));
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ТаблицаРезультат Цикл
		
		Ключ = СтрокаТаблицы.КоробочныйШтрихкод;
		Если Не ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Счетчики.Получить(Ключ) > 1 Тогда
			
			Если СтрокаТаблицы.Статус = "КСозданию" Тогда
				СтрокаТаблицы.Статус = "ДубльВВыборке";
				СтрокаТаблицы.Выбран = Ложь;
			КонецЕсли;
			
			СтрокаТаблицы.Комментарий = СокрЛП(СтрокаТаблицы.Комментарий
				+ " | Несколько баночных ШК дают один коробочный — выберите одну строку вручную");
			
		КонецЕсли;
		
	КонецЦикла;
	
