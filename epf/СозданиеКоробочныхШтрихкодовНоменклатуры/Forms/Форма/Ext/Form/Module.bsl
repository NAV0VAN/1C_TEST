#Область ОписаниеПеременных

&НаКлиенте
Перем ИмяКолонкиВыбран;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТолькоОтсутствующие = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИмяКолонкиВыбран = "Выбран";
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьШтрихкоды(Команда)
	
	Если ШтрихкодыКСозданию.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Сначала заполните таблицу баночных штрихкодов.");
		Возврат;
	КонецЕсли;
	
	ЕстьВыбранные = Ложь;
	Для Каждого СтрокаТаблицы Из ШтрихкодыКСозданию Цикл
		Если СтрокаТаблицы.Выбран Тогда
			ЕстьВыбранные = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьВыбранные Тогда
		ПоказатьПредупреждение(, "Отметьте хотя бы одну строку со статусом «К созданию».");
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьШтрихкодыПослеПодтверждения", ЭтотОбъект);
	ПоказатьВопрос(
		ОписаниеОповещения,
		"Создать коробочные штрихкоды для отмеченных строк?
		|Записи с дублями ШК будут пропущены.",
		РежимДиалогаВопрос.ДаНет, ,
		КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьШтрихкодыПослеПодтверждения(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТекстПротокола = СоздатьШтрихкодыНаСервере();
	ЗаполнитьНаСервере();
	
	ПоказатьПредупреждение(, ТекстПротокола);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсеКСозданию(Команда)
	
	Для Каждого СтрокаТаблицы Из ШтрихкодыКСозданию Цикл
		СтрокаТаблицы.Выбран = (СтрокаТаблицы.Статус = "КСозданию");
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	
	Для Каждого СтрокаТаблицы Из ШтрихкодыКСозданию Цикл
		СтрокаТаблицы.Выбран = Ложь;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицы

&НаКлиенте
Процедура ШтрихкодыКСозданиюВыбранПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ШтрихкодыКСозданию.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Выбран
		И ТекущиеДанные.Статус <> "КСозданию"
		И ТекущиеДанные.Статус <> "ДубльВВыборке" Тогда
		
		ТекущиеДанные.Выбран = Ложь;
		ПоказатьПредупреждение(,
			"Нельзя создавать строку со статусом дубля/конфликта.
			|Сначала устраните дубль штрихкода в регистре.");
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Таблица = ОбработкаОбъект.ПолучитьТаблицуКСозданию(ТолькоОтсутствующие);
	
	ШтрихкодыКСозданию.Очистить();
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		НоваяСтрока = ШтрихкодыКСозданию.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЦикла;
	
	ОбновитьИтогиНаСервере();
	
КонецПроцедуры

&НаСервере
Функция СоздатьШтрихкодыНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Таблица = ОбработкаОбъект.ПолучитьТаблицуКСозданию(Ложь);
	Таблица.Очистить();
	
	Для Каждого СтрокаФормы Из ШтрихкодыКСозданию Цикл
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаФормы);
	КонецЦикла;
	
	Результат = ОбработкаОбъект.СоздатьКоробочныеШтрихкоды(Таблица);
	
	Возврат СтрСоединить(Результат.Сообщения, Символы.ПС);
	
КонецФункции

&НаСервере
Процедура ОбновитьИтогиНаСервере()
	
	Всего = ШтрихкодыКСозданию.Количество();
	КСозданию = 0;
	Дубли = 0;
	Конфликты = 0;
	
	Для Каждого СтрокаТаблицы Из ШтрихкодыКСозданию Цикл
		Если СтрокаТаблицы.Статус = "КСозданию" Тогда
			КСозданию = КСозданию + 1;
		ИначеЕсли СтрокаТаблицы.Статус = "УжеЕсть" Или СтрокаТаблицы.Статус = "ДубльВВыборке" Тогда
			Дубли = Дубли + 1;
		ИначеЕсли СтрокаТаблицы.Статус = "КонфликтДубля" Тогда
			Конфликты = Конфликты + 1;
		КонецЕсли;
	КонецЦикла;
	
	НадписьИтоги = СтрШаблон(
		"Всего строк: %1 | к созданию: %2 | дубли: %3 | конфликты дублей: %4",
		Всего, КСозданию, Дубли, Конфликты);
	
КонецПроцедуры

#КонецОбласти
